# Copy to .dev.vars for local dev. Never commit .dev.vars.
SESSION_SECRET=change-me-to-64-random-hex
# Settlement hot wallet: holds ETH on Robinhood Chain for gas ONLY.
SETTLEMENT_PRIVATE_KEY=0x...
# Optional keyed RPCs (public ones throttle Workers)
ROBINHOOD_RPC_URL=
MAINNET_RPC_URL=
# Security reviews (HEY Research Lab): comma-separated signer addresses, and the token for their requests feed
HEY_REVIEW_SIGNERS=
HEY_REVIEW_FEED_TOKEN=
